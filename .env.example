# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=drl_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/drl_db

# Security & Sessions
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars
SESSION_EXPIRE_HOURS=24

# Demo Credentials
DEMO_PASSWORD=Demo@123456

# Storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=10
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=evidence
IS_PRODUCTION=false
CRON_SECRET=

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_BASE_URL=/api/v1
VITE_DIRECT_UPLOAD=false
