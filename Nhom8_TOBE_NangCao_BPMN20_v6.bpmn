<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_Nhom8_ToBe_Advanced" targetNamespace="https://mis3047.nhom8.local/to-be-advanced" exporter="MIS3047 BPMN 2.0" exporterVersion="6.0">
  <bpmn:message id="Msg_Campaign" name="Thông báo mở đợt chấm điểm"/>
  <bpmn:message id="Msg_Submission" name="Bảng tự chấm và minh chứng"/>
  <bpmn:message id="Msg_FixInfoRequest" name="Yêu cầu bổ sung thông tin"/>
  <bpmn:message id="Msg_InfoUpdate" name="Hồ sơ bổ sung thông tin"/>
  <bpmn:message id="Msg_ProofRequest" name="Yêu cầu bổ sung minh chứng"/>
  <bpmn:message id="Msg_ProofUpdate" name="Minh chứng đã bổ sung"/>
  <bpmn:message id="Msg_CaseClosed" name="Thông báo đóng hồ sơ quá hạn"/>
  <bpmn:message id="Msg_Draft" name="Thông báo điểm dự kiến"/>
  <bpmn:message id="Msg_Reminder" name="Nhắc nhở hạn phản hồi"/>
  <bpmn:message id="Msg_Accept" name="Xác nhận đồng ý điểm"/>
  <bpmn:message id="Msg_Appeal" name="Giải trình / khiếu nại điểm"/>
  <bpmn:message id="Msg_Resolution" name="Kết quả giải quyết khiếu nại"/>
  <bpmn:message id="Msg_Final" name="Bảng điểm đã chốt chuyển GVCN"/>
  <bpmn:message id="Msg_AutoAccepted" name="Thông báo hết hạn phản hồi – điểm được tự động chấp nhận"/>
  <bpmn:error id="Error_AIProcessing" name="Không thể phân tích minh chứng bằng AI" errorCode="AI_DOC_READ_FAILURE"/>
  <bpmn:resource id="Res_BCS" name="Ban cán sự lớp"/>
  <bpmn:collaboration id="Collaboration_ToBe_Advanced" name="Cộng tác chấm điểm rèn luyện – TO-BE">
    <bpmn:participant id="Pool_Student" name="Sinh viên" processRef="Process_Student">
      <bpmn:participantMultiplicity minimum="1" maximum="1000"/>
    </bpmn:participant>
    <bpmn:participant id="Pool_School" name="Nhà trường: hệ thống và ban cán sự" processRef="Process_School"/>
    <bpmn:participant id="Pool_GVCN" name="Giáo viên chủ nhiệm (bên nhận)"/>
    <bpmn:messageFlow id="MF01" name="Mở đợt" sourceRef="SC_Notify" targetRef="ST_Start" messageRef="Msg_Campaign"/>
    <bpmn:messageFlow id="MF02" name="Nộp tự chấm" sourceRef="ST_Submit" targetRef="SC_GetSubmission" messageRef="Msg_Submission"/>
    <bpmn:messageFlow id="MF03" name="Yêu cầu bổ sung thông tin" sourceRef="SC_MissingNotice" targetRef="ES_Info_Start" messageRef="Msg_FixInfoRequest"/>
    <bpmn:messageFlow id="MF04" name="Nộp bổ sung" sourceRef="ST_SendInfo" targetRef="SC_GetInfo" messageRef="Msg_InfoUpdate"/>
    <bpmn:messageFlow id="MF05" name="Hồ sơ quá hạn" sourceRef="SC_CloseIncomplete" targetRef="ES_Closed_Start" messageRef="Msg_CaseClosed"/>
    <bpmn:messageFlow id="MF06" name="Yêu cầu bổ sung minh chứng" sourceRef="SC_RequestProof" targetRef="ES_Proof_Start" messageRef="Msg_ProofRequest"/>
    <bpmn:messageFlow id="MF07" name="Cập nhật minh chứng" sourceRef="ST_SendProof" targetRef="SC_GetProof" messageRef="Msg_ProofUpdate"/>
    <bpmn:messageFlow id="MF08" name="Thông báo điểm dự kiến" sourceRef="SC_NotifyDraft" targetRef="ST_GetDraft" messageRef="Msg_Draft"/>
    <bpmn:messageFlow id="MF13" name="Nhắc hạn" sourceRef="SC_SendReminder" targetRef="ES_Remind_Start" messageRef="Msg_Reminder"/>
    <bpmn:messageFlow id="MF09" name="Đồng ý điểm" sourceRef="ST_SendAccept" targetRef="SC_GetAccept" messageRef="Msg_Accept"/>
    <bpmn:messageFlow id="MF10" name="Gửi giải trình" sourceRef="ST_SendAppeal" targetRef="SC_GetAppeal" messageRef="Msg_Appeal"/>
    <bpmn:messageFlow id="MF11" name="Phản hồi giải trình" sourceRef="SC_ReplyAppeal" targetRef="ST_GetResolution" messageRef="Msg_Resolution"/>
    <bpmn:messageFlow id="MF12" name="Bảng điểm đã chốt" sourceRef="SC_SendFinal" targetRef="Pool_GVCN" messageRef="Msg_Final"/>
    <bpmn:messageFlow id="MF14" name="Đóng hồ sơ do không nộp" sourceRef="SC_RecordNoSubmit" targetRef="ES_Closed_Start" messageRef="Msg_CaseClosed"/>
    <bpmn:messageFlow id="MF15" name="Hết hạn – tự động chấp nhận" sourceRef="SC_AutoAccept" targetRef="ES_AutoAccept_Start" messageRef="Msg_AutoAccepted"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Student" name="Sinh viên tự đánh giá, bổ sung và phản hồi" isExecutable="false">
    <bpmn:startEvent id="ST_Start" name="Nhận thông báo mở đợt">
      <bpmn:outgoing>FST01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EventDef_ST_Start" messageRef="Msg_Campaign"/>
    </bpmn:startEvent>
    <bpmn:userTask id="ST_Login" name="Đăng nhập cổng sinh viên">
      <bpmn:incoming>FST01</bpmn:incoming>
      <bpmn:outgoing>FST02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ST_Self" name="Tự chấm điểm và đính kèm minh chứng">
      <bpmn:incoming>FST02</bpmn:incoming>
      <bpmn:outgoing>FST03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ST_Submit" name="Nộp bảng tự chấm và minh chứng">
      <bpmn:incoming>FST03</bpmn:incoming>
      <bpmn:outgoing>FST04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="ST_GetDraft" name="Nhận điểm dự kiến">
      <bpmn:incoming>FST04</bpmn:incoming>
      <bpmn:outgoing>FST08</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EventDef_ST_GetDraft" messageRef="Msg_Draft"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="ST_View" name="Xem điểm dự kiến và quyết định phản hồi">
      <bpmn:incoming>FST08</bpmn:incoming>
      <bpmn:outgoing>FST09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="ST_ViewTimeout" name="Hết hạn phản hồi" attachedToRef="ST_View" cancelActivity="true">
      <bpmn:documentation>Timer boundary ngắt gắn vào bước chờ quyết định của sinh viên (xem điểm và quyết định phản hồi): hết hạn mà chưa phản hồi thì coi như chấp nhận điểm. Lưu ý v5: đây chỉ là lớp tiện ích phía sinh viên; việc đóng phiên khi hết hạn ở MỌI bước (xem điểm, soạn giải trình, soạn xác nhận) do thông điệp của nhà trường (MF15) kích hoạt event sub-process ES_AutoAccept, vì nhà trường là bên giữ đồng hồ chuẩn. Thời hạn là tham số cấu hình (Tobe.docx chưa quy định số ngày cụ thể); nhà trường/BCS khai báo khi triển khai.</bpmn:documentation>
      <bpmn:outgoing>FST16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="EventDef_ST_ViewTimeout"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${appealPeriod}</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="ST_EndSilent" name="Hết hạn phản hồi – điểm được tự động chấp nhận">
      <bpmn:incoming>FST16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="ST_GAppeal" default="FST13" name="Có khiếu nại?">
      <bpmn:incoming>FST09</bpmn:incoming>
      <bpmn:outgoing>FST10</bpmn:outgoing>
      <bpmn:outgoing>FST13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ST_SendAppeal" name="Lập giải trình khiếu nại và nộp">
      <bpmn:incoming>FST10</bpmn:incoming>
      <bpmn:outgoing>FST11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="ST_GetResolution" name="Nhận kết quả giải trình">
      <bpmn:incoming>FST11</bpmn:incoming>
      <bpmn:outgoing>FST12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EventDef_ST_GetResolution" messageRef="Msg_Resolution"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ST_EndAppeal" name="Đã nhận kết quả giải quyết">
      <bpmn:incoming>FST12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ST_SendAccept" name="Xác nhận đồng ý điểm và nộp">
      <bpmn:incoming>FST13</bpmn:incoming>
      <bpmn:outgoing>FST14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ST_EndAccept" name="Đã xác nhận điểm">
      <bpmn:incoming>FST14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="ES_Info" name="Event sub-process: bổ sung hồ sơ khi được yêu cầu" triggeredByEvent="true">
      <bpmn:documentation>Event sub-process phía sinh viên (message start, không ngắt): mỗi khi nhận yêu cầu bổ sung hồ sơ thì sinh viên nộp lại; có thể lặp nhiều lần mà không cần vòng lặp trong luồng chính.</bpmn:documentation>
      <bpmn:startEvent id="ES_Info_Start" name="Nhận yêu cầu bổ sung hồ sơ" isInterrupting="false">
        <bpmn:outgoing>FES_I1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="EventDef_ES_Info_Start" messageRef="Msg_FixInfoRequest"/>
      </bpmn:startEvent>
      <bpmn:userTask id="ST_SendInfo" name="Bổ sung thông tin hồ sơ và nộp lại">
        <bpmn:incoming>FES_I1</bpmn:incoming>
        <bpmn:outgoing>FES_I2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="ES_Info_End" name="Đã nộp bổ sung">
        <bpmn:incoming>FES_I2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="FES_I1" sourceRef="ES_Info_Start" targetRef="ST_SendInfo"/>
      <bpmn:sequenceFlow id="FES_I2" sourceRef="ST_SendInfo" targetRef="ES_Info_End"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="ES_Proof" name="Event sub-process: bổ sung minh chứng khi được yêu cầu" triggeredByEvent="true">
      <bpmn:documentation>Event sub-process phía sinh viên (message start, không ngắt): mỗi khi nhận yêu cầu bổ sung minh chứng thì sinh viên nộp lại.</bpmn:documentation>
      <bpmn:startEvent id="ES_Proof_Start" name="Nhận yêu cầu bổ sung minh chứng" isInterrupting="false">
        <bpmn:outgoing>FES_P1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="EventDef_ES_Proof_Start" messageRef="Msg_ProofRequest"/>
      </bpmn:startEvent>
      <bpmn:userTask id="ST_SendProof" name="Bổ sung minh chứng và nộp lại">
        <bpmn:incoming>FES_P1</bpmn:incoming>
        <bpmn:outgoing>FES_P2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="ES_Proof_End" name="Đã nộp minh chứng">
        <bpmn:incoming>FES_P2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="FES_P1" sourceRef="ES_Proof_Start" targetRef="ST_SendProof"/>
      <bpmn:sequenceFlow id="FES_P2" sourceRef="ST_SendProof" targetRef="ES_Proof_End"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="ES_Remind" name="Event sub-process: nhận nhắc nhở hạn phản hồi" triggeredByEvent="true">
      <bpmn:documentation>Event sub-process phía sinh viên (message start, không ngắt): nhận nhắc nhở hạn phản hồi từ nhà trường.</bpmn:documentation>
      <bpmn:startEvent id="ES_Remind_Start" name="Nhận nhắc nhở" isInterrupting="false">
        <bpmn:outgoing>FES_R1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="EventDef_ES_Remind_Start" messageRef="Msg_Reminder"/>
      </bpmn:startEvent>
      <bpmn:endEvent id="ES_Remind_End" name="Đã đọc nhắc nhở">
        <bpmn:incoming>FES_R1</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="FES_R1" sourceRef="ES_Remind_Start" targetRef="ES_Remind_End"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="ES_Closed" name="Event sub-process: nhận thông báo đóng hồ sơ" triggeredByEvent="true">
      <bpmn:documentation>Event sub-process phía sinh viên (message start, NGẮT): nhà trường là bên giữ đồng hồ nên khi đóng hồ sơ (không nộp đúng hạn, hoặc quá hạn bổ sung) sẽ gửi Msg_CaseClosed; sinh viên đang ở bất kỳ bước nào (đăng nhập, tự chấm, nộp, chờ kết quả) đều được đóng phiên sạch, không còn token treo. Thay cho nhánh ST_WaitReply/ST_GetClosed của v4.</bpmn:documentation>
      <bpmn:startEvent id="ES_Closed_Start" name="Nhận thông báo đóng hồ sơ" isInterrupting="true">
        <bpmn:outgoing>FES_C1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="EventDef_ES_Closed_Start" messageRef="Msg_CaseClosed"/>
      </bpmn:startEvent>
      <bpmn:endEvent id="ES_Closed_End" name="Hồ sơ không hoàn tất đúng hạn">
        <bpmn:incoming>FES_C1</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="FES_C1" sourceRef="ES_Closed_Start" targetRef="ES_Closed_End"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="ES_AutoAccept" name="Event sub-process: hết hạn phản hồi (tự động chấp nhận)" triggeredByEvent="true">
      <bpmn:documentation>Event sub-process phía sinh viên (message start, NGẮT): khi nhà trường hết hạn đồng ý/khiếu nại và tự động chấp nhận điểm (SC_AutoAccept) thì gửi Msg_AutoAccepted; sinh viên đang xem điểm hoặc đang soạn giải trình/xác nhận đều được đóng phiên, không bị treo ở ST_GetResolution. Nhà trường chỉ gửi thông điệp này khi chưa nhận đồng ý/khiếu nại (nhánh loại trừ của SC_WaitAppeal) nên không cắt nhầm sinh viên đang chờ kết quả giải trình.</bpmn:documentation>
      <bpmn:startEvent id="ES_AutoAccept_Start" name="Nhận thông báo hết hạn phản hồi" isInterrupting="true">
        <bpmn:outgoing>FES_A1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="EventDef_ES_AutoAccept_Start" messageRef="Msg_AutoAccepted"/>
      </bpmn:startEvent>
      <bpmn:endEvent id="ES_AutoAccept_End" name="Hết hạn phản hồi – điểm được tự động chấp nhận">
        <bpmn:incoming>FES_A1</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="FES_A1" sourceRef="ES_AutoAccept_Start" targetRef="ES_AutoAccept_End"/>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="FST01" sourceRef="ST_Start" targetRef="ST_Login"/>
    <bpmn:sequenceFlow id="FST02" sourceRef="ST_Login" targetRef="ST_Self"/>
    <bpmn:sequenceFlow id="FST03" sourceRef="ST_Self" targetRef="ST_Submit"/>
    <bpmn:sequenceFlow id="FST04" sourceRef="ST_Submit" targetRef="ST_GetDraft"/>
    <bpmn:sequenceFlow id="FST08" sourceRef="ST_GetDraft" targetRef="ST_View"/>
    <bpmn:sequenceFlow id="FST09" sourceRef="ST_View" targetRef="ST_GAppeal"/>
    <bpmn:sequenceFlow id="FST10" name="Có" sourceRef="ST_GAppeal" targetRef="ST_SendAppeal"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${appealFiled}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FST11" sourceRef="ST_SendAppeal" targetRef="ST_GetResolution"/>
    <bpmn:sequenceFlow id="FST12" sourceRef="ST_GetResolution" targetRef="ST_EndAppeal"/>
    <bpmn:sequenceFlow id="FST13" name="Không" sourceRef="ST_GAppeal" targetRef="ST_SendAccept"/>
    <bpmn:sequenceFlow id="FST14" sourceRef="ST_SendAccept" targetRef="ST_EndAccept"/>
    <bpmn:sequenceFlow id="FST16" sourceRef="ST_ViewTimeout" targetRef="ST_EndSilent"/>
  </bpmn:process>
  <bpmn:process id="Process_School" name="Điều phối, AI thẩm định, họp lớp và chốt điểm" isExecutable="false">
    <bpmn:documentation>TO-BE v6 (vá v4/v5 sau rà soát token giữa 2 pool và nhắc hạn): hai multi-instance (xử lý hồ sơ từng SV; phản hồi và khiếu nại từng SV) tách khỏi các bước cấp lớp (họp BCS, họp lớp, công bố, chốt, gửi GVCN).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_School">
      <bpmn:lane id="Lane_System" name="Hệ thống / AI Agent">
        <bpmn:flowNodeRef>SC_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_PerStudent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_RespPerStudent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BCS" name="Ban cán sự lớp">
        <bpmn:flowNodeRef>SC_MeetBCS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_ReviewDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_ClassMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_PublishDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_Finalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_SendFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SC_Start" name="Đến kỳ mở chấm điểm">
      <bpmn:documentation>Thời điểm mở đợt chấm điểm (campaignOpenAt). Thời hạn là tham số cấu hình (Tobe.docx chưa quy định số ngày cụ thể); nhà trường/BCS khai báo khi triển khai.</bpmn:documentation>
      <bpmn:outgoing>FSC01</bpmn:outgoing>
      <bpmn:timerEventDefinition id="EventDef_SC_Start"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">${campaignOpenAt}</bpmn:timeDate></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sendTask id="SC_Notify" name="Tự động thông báo mở đợt" messageRef="Msg_Campaign">
      <bpmn:incoming>FSC01</bpmn:incoming>
      <bpmn:outgoing>FSC02</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:subProcess id="SC_PerStudent" name="Xử lý hồ sơ từng sinh viên (multi-instance)">
      <bpmn:documentation>Multi-instance song song, mỗi sinh viên một instance: nhận hồ sơ (có hạn nộp), kiểm tra đầy đủ, AI đọc và kiểm tra, xử lý cờ, ra quyết định điểm dự kiến. Họp BCS, họp lớp và công bố chỉ chạy một lần cho cả lớp sau khi mọi instance hoàn tất.</bpmn:documentation>
      <bpmn:incoming>FSC02</bpmn:incoming>
      <bpmn:outgoing>FSC31</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_PerStudent">
        <bpmn:dataInput id="DIn_StudentList" name="Danh sách sinh viên của lớp" isCollection="true"/>
        <bpmn:inputSet id="InSet_PerStudent"><bpmn:dataInputRefs>DIn_StudentList</bpmn:dataInputRefs></bpmn:inputSet>
        <bpmn:outputSet id="OutSet_PerStudent"/>
      </bpmn:ioSpecification>
      <bpmn:multiInstanceLoopCharacteristics id="MI_PerStudent" isSequential="false">
        <bpmn:loopDataInputRef>DIn_StudentList</bpmn:loopDataInputRef>
        <bpmn:inputDataItem id="Item_Student" name="Sinh viên"/>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="PST_Start" name="Bắt đầu xử lý SV">
        <bpmn:outgoing>FPST01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:eventBasedGateway id="SC_WaitSubmission" name="Chờ hồ sơ / hết hạn nộp">
        <bpmn:incoming>FPST01</bpmn:incoming>
        <bpmn:outgoing>FSC_W1</bpmn:outgoing>
        <bpmn:outgoing>FSC_W2</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="SC_GetSubmission" name="Nhận hồ sơ tự chấm">
        <bpmn:incoming>FSC_W1</bpmn:incoming>
        <bpmn:outgoing>FSC03</bpmn:outgoing>
        <bpmn:messageEventDefinition id="EventDef_SC_GetSubmission" messageRef="Msg_Submission"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="SC_SubmissionTimeout" name="Hết hạn nộp hồ sơ">
        <bpmn:documentation>Hạn nộp hồ sơ tự chấm (submissionDeadline). Thời hạn là tham số cấu hình (Tobe.docx chưa quy định số ngày cụ thể); nhà trường/BCS khai báo khi triển khai.</bpmn:documentation>
        <bpmn:incoming>FSC_W2</bpmn:incoming>
        <bpmn:outgoing>FSC_W3</bpmn:outgoing>
        <bpmn:timerEventDefinition id="EventDef_SC_SubmissionTimeout"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">${submissionDeadline}</bpmn:timeDate></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="SC_RecordNoSubmit" name="Ghi nhận SV không nộp, báo BCS và thông báo đóng hồ sơ" messageRef="Msg_CaseClosed">
        <bpmn:documentation>Ghi nhận sinh viên không nộp hồ sơ trong hạn, báo ban cán sự xử lý theo quy chế của nhà trường (quy chế cụ thể ngoài phạm vi tài liệu TO-BE) và gửi Msg_CaseClosed cho sinh viên (MF14) để phiên phía sinh viên kết thúc, không bị treo (v5: đổi từ serviceTask sang sendTask).</bpmn:documentation>
        <bpmn:incoming>FSC_W3</bpmn:incoming>
        <bpmn:outgoing>FSC_W4</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="PST_EndNoSubmit" name="Kết thúc: SV không nộp hồ sơ">
        <bpmn:incoming>FSC_W4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="SC_CheckCompleteness" name="Agent điều phối: kiểm tra độ đầy đủ">
        <bpmn:incoming>FSC03</bpmn:incoming>
        <bpmn:incoming>FSC09</bpmn:incoming>
        <bpmn:outgoing>FSC04</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="SC_GComplete" name="Hồ sơ đầy đủ?" default="FSC06b">
        <bpmn:documentation>v5: chặn vòng lặp bổ sung vô hạn. infoRound đếm số lần đã yêu cầu bổ sung thông tin (tăng 1 mỗi lần SC_MissingNotice gửi); maxInfoRounds là tham số cấu hình. Hết lượt mà vẫn thiếu thì đóng hồ sơ.</bpmn:documentation>
        <bpmn:incoming>FSC04</bpmn:incoming>
        <bpmn:outgoing>FSC05</bpmn:outgoing>
        <bpmn:outgoing>FSC06</bpmn:outgoing>
        <bpmn:outgoing>FSC06b</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SC_Package" name="Agent điều phối: chuẩn hóa và đóng gói">
        <bpmn:incoming>FSC05</bpmn:incoming>
        <bpmn:outgoing>FSC13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SC_MissingNotice" name="Yêu cầu bổ sung thông tin" messageRef="Msg_FixInfoRequest">
        <bpmn:documentation>Mỗi lần gửi: infoRound = infoRound + 1. Mỗi vòng vẫn có hạn riêng supplementPeriod; tổng thời gian tối đa = maxInfoRounds × supplementPeriod.</bpmn:documentation>
        <bpmn:incoming>FSC06</bpmn:incoming>
        <bpmn:outgoing>FSC07</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="SC_WaitInfo" name="Chờ hồ sơ bổ sung / quá hạn">
        <bpmn:incoming>FSC07</bpmn:incoming>
        <bpmn:outgoing>FSC08</bpmn:outgoing>
        <bpmn:outgoing>FSC10</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="SC_GetInfo" name="Nhận hồ sơ cập nhật">
        <bpmn:incoming>FSC08</bpmn:incoming>
        <bpmn:outgoing>FSC09</bpmn:outgoing>
        <bpmn:messageEventDefinition id="EventDef_SC_GetInfo" messageRef="Msg_InfoUpdate"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="SC_InfoTimeout" name="Hết hạn bổ sung thông tin">
        <bpmn:documentation>Hạn bổ sung thông tin (supplementPeriod). Thời hạn là tham số cấu hình (Tobe.docx chưa quy định số ngày cụ thể); nhà trường/BCS khai báo khi triển khai.</bpmn:documentation>
        <bpmn:incoming>FSC10</bpmn:incoming>
        <bpmn:outgoing>FSC11</bpmn:outgoing>
        <bpmn:timerEventDefinition id="EventDef_SC_InfoTimeout"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${supplementPeriod}</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="SC_CloseIncomplete" name="Ghi nhận quá hạn và thông báo đóng hồ sơ" messageRef="Msg_CaseClosed">
        <bpmn:incoming>FSC11</bpmn:incoming>
        <bpmn:incoming>FSC06b</bpmn:incoming>
        <bpmn:outgoing>FSC12</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="SC_EndIncomplete" name="Kết thúc hồ sơ không hoàn tất">
        <bpmn:incoming>FSC12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:subProcess id="SC_AlertEventSub" name="Event sub-process: cảnh báo minh chứng bị gắn cờ" triggeredByEvent="true">
        <bpmn:documentation>Chạy song song, không ngắt luồng chính: khi alertPending = true thì Agent điều phối tạo cảnh báo gửi ban cán sự. Đây là bước hiện thực yêu cầu in đậm trong Tobe.docx ("Agent Điều phối gửi thông báo cần sự can thiệp của ban cán sự"). v5: dùng MỘT biến alertPending thay cho cặp evidenceFlagged/alertSent để mỗi lần gắn cờ (kể cả lần 2 sau khi SV bổ sung minh chứng) đều tạo được một chuyển false→true mới.</bpmn:documentation>
        <bpmn:startEvent id="EA_Start" name="Có minh chứng bị gắn cờ" isInterrupting="false">
          <bpmn:outgoing>FEA01</bpmn:outgoing>
          <bpmn:conditionalEventDefinition id="EventDef_EA_Start"><bpmn:condition xsi:type="bpmn:tFormalExpression">${alertPending}</bpmn:condition></bpmn:conditionalEventDefinition>
        </bpmn:startEvent>
        <bpmn:serviceTask id="EA_SendAlert" name="Agent điều phối tạo cảnh báo gửi ban cán sự">
          <bpmn:documentation>Thông báo nội bộ trong cùng pool nên dùng service task (không có message flow). Sau khi gửi đặt alertPending = false; SC_Flag sẽ đặt lại alertPending = true ở lần gắn cờ kế tiếp nên không cần bước reset riêng khi nhận minh chứng mới.</bpmn:documentation>
          <bpmn:incoming>FEA01</bpmn:incoming>
          <bpmn:outgoing>FEA02</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="EA_End" name="Đã gửi cảnh báo">
          <bpmn:incoming>FEA02</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="FEA01" sourceRef="EA_Start" targetRef="EA_SendAlert"/>
        <bpmn:sequenceFlow id="FEA02" sourceRef="EA_SendAlert" targetRef="EA_End"/>
      </bpmn:subProcess>
      <bpmn:subProcess id="SC_AIReview" name="AI Agent đọc và kiểm tra minh chứng">
        <bpmn:documentation>Agent đọc dữ liệu và Agent kiểm tra tính minh bạch. Lỗi đọc kỹ thuật phát error event; minh chứng sai là kết quả nghiệp vụ, không phải lỗi.</bpmn:documentation>
        <bpmn:incoming>FSC13</bpmn:incoming>
        <bpmn:incoming>FSC25</bpmn:incoming>
        <bpmn:outgoing>FSC14</bpmn:outgoing>
        <bpmn:dataObject id="Data_HS" name="Bảng tự chấm + tệp minh chứng"/>
        <bpmn:dataObjectReference id="DataRef_HS" name="Bảng tự chấm + tệp minh chứng" dataObjectRef="Data_HS"/>
        <bpmn:dataObject id="Data_Reg" name="Tài liệu hướng dẫn chấm điểm"/>
        <bpmn:dataObjectReference id="DataRef_Reg" name="Tài liệu hướng dẫn chấm điểm" dataObjectRef="Data_Reg"/>
        <bpmn:startEvent id="AI_Start" name="Bắt đầu xử lý AI">
          <bpmn:outgoing>FAI01</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="AI_Read" name="Agent đọc dữ liệu: trích xuất điểm và tệp">
          <bpmn:incoming>FAI01</bpmn:incoming>
          <bpmn:outgoing>FAI02</bpmn:outgoing>
          <bpmn:ioSpecification id="IO_AI_Read">
            <bpmn:dataInput id="DIn_HS" name="Bảng tự chấm + tệp minh chứng"/>
            <bpmn:inputSet id="InSet_AI_Read"><bpmn:dataInputRefs>DIn_HS</bpmn:dataInputRefs></bpmn:inputSet>
            <bpmn:outputSet id="OutSet_AI_Read"/>
          </bpmn:ioSpecification>
          <bpmn:dataInputAssociation id="DIA_HS_Read"><bpmn:sourceRef>DataRef_HS</bpmn:sourceRef><bpmn:targetRef>DIn_HS</bpmn:targetRef></bpmn:dataInputAssociation>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="AI_GReadable" default="FAI05" name="Đọc được dữ liệu?">
          <bpmn:incoming>FAI02</bpmn:incoming>
          <bpmn:outgoing>FAI03</bpmn:outgoing>
          <bpmn:outgoing>FAI05</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="AI_Transparency" name="Agent minh bạch: đối chiếu quy định, trùng lặp, thời hạn">
          <bpmn:incoming>FAI03</bpmn:incoming>
          <bpmn:outgoing>FAI04</bpmn:outgoing>
          <bpmn:ioSpecification id="IO_AI_Transparency">
            <bpmn:dataInput id="DIn_Reg" name="Tài liệu hướng dẫn chấm điểm"/>
            <bpmn:inputSet id="InSet_AI_Transparency"><bpmn:dataInputRefs>DIn_Reg</bpmn:dataInputRefs></bpmn:inputSet>
            <bpmn:outputSet id="OutSet_AI_Transparency"/>
          </bpmn:ioSpecification>
          <bpmn:dataInputAssociation id="DIA_Reg_Transparency"><bpmn:sourceRef>DataRef_Reg</bpmn:sourceRef><bpmn:targetRef>DIn_Reg</bpmn:targetRef></bpmn:dataInputAssociation>
        </bpmn:serviceTask>
        <bpmn:endEvent id="AI_End" name="Đã phân loại tính hợp lệ">
          <bpmn:incoming>FAI04</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:endEvent id="AI_ErrorEnd" name="Lỗi đọc không thể tự khôi phục">
          <bpmn:incoming>FAI05</bpmn:incoming>
          <bpmn:errorEventDefinition id="EventDef_AI_ErrorEnd" errorRef="Error_AIProcessing"/>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="FAI01" sourceRef="AI_Start" targetRef="AI_Read"/>
        <bpmn:sequenceFlow id="FAI02" sourceRef="AI_Read" targetRef="AI_GReadable"/>
        <bpmn:sequenceFlow id="FAI03" name="Đọc được" sourceRef="AI_GReadable" targetRef="AI_Transparency"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${readable}</bpmn:conditionExpression></bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="FAI04" sourceRef="AI_Transparency" targetRef="AI_End"/>
        <bpmn:sequenceFlow id="FAI05" name="Lỗi kỹ thuật" sourceRef="AI_GReadable" targetRef="AI_ErrorEnd"/>
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="SC_AIError" name="Lỗi Agent đọc minh chứng" attachedToRef="SC_AIReview" cancelActivity="true">
        <bpmn:outgoing>FSC15</bpmn:outgoing>
        <bpmn:errorEventDefinition id="EventDef_SC_AIError" errorRef="Error_AIProcessing"/>
      </bpmn:boundaryEvent>
      <bpmn:userTask id="SC_HumanAIReview" name="BCS kiểm tra thủ công khi Agent lỗi">
        <bpmn:incoming>FSC15</bpmn:incoming>
        <bpmn:outgoing>FSC16</bpmn:outgoing>
        <bpmn:humanPerformer id="HP_SC_HumanAIReview"><bpmn:resourceRef>Res_BCS</bpmn:resourceRef></bpmn:humanPerformer>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SC_MergeValid" name="Hợp nhất kết quả kiểm tra">
        <bpmn:incoming>FSC14</bpmn:incoming>
        <bpmn:incoming>FSC16</bpmn:incoming>
        <bpmn:outgoing>FSC14b</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="SC_GValid" default="FSC18" name="Minh chứng hợp lệ?">
        <bpmn:incoming>FSC14b</bpmn:incoming>
        <bpmn:outgoing>FSC17</bpmn:outgoing>
        <bpmn:outgoing>FSC18</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SC_Flag" name="Gắn cờ minh chứng không hợp lệ">
        <bpmn:documentation>Đặt evidenceFlagged = true và alertPending = true cho các minh chứng thiếu/không hợp lệ và lưu kết quả kiểm tra. alertPending kích hoạt event sub-process cảnh báo.</bpmn:documentation>
        <bpmn:incoming>FSC18</bpmn:incoming>
        <bpmn:outgoing>FSC19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="SC_BCSFlags" name="BCS xem các minh chứng bị gắn cờ">
        <bpmn:incoming>FSC19</bpmn:incoming>
        <bpmn:outgoing>FSC20</bpmn:outgoing>
        <bpmn:humanPerformer id="HP_SC_BCSFlags"><bpmn:resourceRef>Res_BCS</bpmn:resourceRef></bpmn:humanPerformer>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SC_GProofNeed" name="Cần bổ sung?" default="FSC22">
        <bpmn:documentation>v5: chặn vòng lặp bổ sung minh chứng vô hạn. Chỉ yêu cầu bổ sung khi BCS quyết định cần bổ sung VÀ proofRound &lt; maxProofRounds; ngược lại chuyển BCS kết luận mục không hợp lệ.</bpmn:documentation>
        <bpmn:incoming>FSC20</bpmn:incoming>
        <bpmn:outgoing>FSC21</bpmn:outgoing>
        <bpmn:outgoing>FSC22</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="SC_RequestProof" name="Agent điều phối: yêu cầu bổ sung minh chứng" messageRef="Msg_ProofRequest">
        <bpmn:documentation>Mỗi lần gửi: proofRound = proofRound + 1. Mỗi vòng vẫn có hạn riêng supplementPeriod; tổng thời gian tối đa = maxProofRounds × supplementPeriod.</bpmn:documentation>
        <bpmn:incoming>FSC21</bpmn:incoming>
        <bpmn:outgoing>FSC23</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="SC_WaitProof" name="Chờ minh chứng / quá hạn">
        <bpmn:incoming>FSC23</bpmn:incoming>
        <bpmn:outgoing>FSC24</bpmn:outgoing>
        <bpmn:outgoing>FSC26</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="SC_GetProof" name="Nhận minh chứng bổ sung">
        <bpmn:incoming>FSC24</bpmn:incoming>
        <bpmn:outgoing>FSC25</bpmn:outgoing>
        <bpmn:messageEventDefinition id="EventDef_SC_GetProof" messageRef="Msg_ProofUpdate"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="SC_ProofTimeout" name="Hết hạn bổ sung minh chứng">
        <bpmn:documentation>Hạn bổ sung minh chứng (supplementPeriod). Thời hạn là tham số cấu hình (Tobe.docx chưa quy định số ngày cụ thể); nhà trường/BCS khai báo khi triển khai.</bpmn:documentation>
        <bpmn:incoming>FSC26</bpmn:incoming>
        <bpmn:outgoing>FSC27</bpmn:outgoing>
        <bpmn:timerEventDefinition id="EventDef_SC_ProofTimeout"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${supplementPeriod}</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="SC_InvalidConclusion" name="BCS xác nhận mục không hợp lệ, lý do trừ điểm">
        <bpmn:incoming>FSC22</bpmn:incoming>
        <bpmn:incoming>FSC27</bpmn:incoming>
        <bpmn:outgoing>FSC28</bpmn:outgoing>
        <bpmn:humanPerformer id="HP_SC_InvalidConclusion"><bpmn:resourceRef>Res_BCS</bpmn:resourceRef></bpmn:humanPerformer>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SC_MergeReview" name="Hoàn tất kiểm tra">
        <bpmn:incoming>FSC17</bpmn:incoming>
        <bpmn:incoming>FSC28</bpmn:incoming>
        <bpmn:outgoing>FSC29</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SC_Decision" name="Agent ra quyết định: áp dụng quy tắc trừ và tính điểm">
        <bpmn:incoming>FSC29</bpmn:incoming>
        <bpmn:outgoing>FSC30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="SC_Draft" name="Ghi điểm dự kiến vào bảng tổng hợp">
        <bpmn:incoming>FSC30</bpmn:incoming>
        <bpmn:outgoing>FPST_END</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="PST_End" name="Hoàn tất xử lý SV">
        <bpmn:incoming>FPST_END</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="FPST01" sourceRef="PST_Start" targetRef="SC_WaitSubmission"/>
      <bpmn:sequenceFlow id="FSC_W1" sourceRef="SC_WaitSubmission" targetRef="SC_GetSubmission"/>
      <bpmn:sequenceFlow id="FSC_W2" sourceRef="SC_WaitSubmission" targetRef="SC_SubmissionTimeout"/>
      <bpmn:sequenceFlow id="FSC_W3" sourceRef="SC_SubmissionTimeout" targetRef="SC_RecordNoSubmit"/>
      <bpmn:sequenceFlow id="FSC_W4" sourceRef="SC_RecordNoSubmit" targetRef="PST_EndNoSubmit"/>
      <bpmn:sequenceFlow id="FSC03" sourceRef="SC_GetSubmission" targetRef="SC_CheckCompleteness"/>
      <bpmn:sequenceFlow id="FSC04" sourceRef="SC_CheckCompleteness" targetRef="SC_GComplete"/>
      <bpmn:sequenceFlow id="FSC05" name="Đầy đủ" sourceRef="SC_GComplete" targetRef="SC_Package"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${infoComplete}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="FSC06" name="Thiếu" sourceRef="SC_GComplete" targetRef="SC_MissingNotice"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!infoComplete &amp;&amp; infoRound &lt; maxInfoRounds}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="FSC06b" name="Thiếu, hết lượt" sourceRef="SC_GComplete" targetRef="SC_CloseIncomplete"/>
      <bpmn:sequenceFlow id="FSC07" sourceRef="SC_MissingNotice" targetRef="SC_WaitInfo"/>
      <bpmn:sequenceFlow id="FSC08" sourceRef="SC_WaitInfo" targetRef="SC_GetInfo"/>
      <bpmn:sequenceFlow id="FSC10" sourceRef="SC_WaitInfo" targetRef="SC_InfoTimeout"/>
      <bpmn:sequenceFlow id="FSC11" sourceRef="SC_InfoTimeout" targetRef="SC_CloseIncomplete"/>
      <bpmn:sequenceFlow id="FSC12" sourceRef="SC_CloseIncomplete" targetRef="SC_EndIncomplete"/>
      <bpmn:sequenceFlow id="FSC09" sourceRef="SC_GetInfo" targetRef="SC_CheckCompleteness"/>
      <bpmn:sequenceFlow id="FSC13" sourceRef="SC_Package" targetRef="SC_AIReview"/>
      <bpmn:sequenceFlow id="FSC14" sourceRef="SC_AIReview" targetRef="SC_MergeValid"/>
      <bpmn:sequenceFlow id="FSC15" sourceRef="SC_AIError" targetRef="SC_HumanAIReview"/>
      <bpmn:sequenceFlow id="FSC16" sourceRef="SC_HumanAIReview" targetRef="SC_MergeValid"/>
      <bpmn:sequenceFlow id="FSC14b" sourceRef="SC_MergeValid" targetRef="SC_GValid"/>
      <bpmn:sequenceFlow id="FSC17" name="Hợp lệ" sourceRef="SC_GValid" targetRef="SC_MergeReview"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${evidenceValid}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="FSC18" name="Có vấn đề" sourceRef="SC_GValid" targetRef="SC_Flag"/>
      <bpmn:sequenceFlow id="FSC19" sourceRef="SC_Flag" targetRef="SC_BCSFlags"/>
      <bpmn:sequenceFlow id="FSC20" sourceRef="SC_BCSFlags" targetRef="SC_GProofNeed"/>
      <bpmn:sequenceFlow id="FSC21" name="Cần bổ sung" sourceRef="SC_GProofNeed" targetRef="SC_RequestProof"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bcsRequestsProof &amp;&amp; proofRound &lt; maxProofRounds}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="FSC22" name="Không cần / hết lượt" sourceRef="SC_GProofNeed" targetRef="SC_InvalidConclusion"/>
      <bpmn:sequenceFlow id="FSC23" sourceRef="SC_RequestProof" targetRef="SC_WaitProof"/>
      <bpmn:sequenceFlow id="FSC24" sourceRef="SC_WaitProof" targetRef="SC_GetProof"/>
      <bpmn:sequenceFlow id="FSC26" sourceRef="SC_WaitProof" targetRef="SC_ProofTimeout"/>
      <bpmn:sequenceFlow id="FSC27" sourceRef="SC_ProofTimeout" targetRef="SC_InvalidConclusion"/>
      <bpmn:sequenceFlow id="FSC25" sourceRef="SC_GetProof" targetRef="SC_AIReview"/>
      <bpmn:sequenceFlow id="FSC28" sourceRef="SC_InvalidConclusion" targetRef="SC_MergeReview"/>
      <bpmn:sequenceFlow id="FSC29" sourceRef="SC_MergeReview" targetRef="SC_Decision"/>
      <bpmn:sequenceFlow id="FSC30" sourceRef="SC_Decision" targetRef="SC_Draft"/>
      <bpmn:sequenceFlow id="FPST_END" sourceRef="SC_Draft" targetRef="PST_End"/>
    </bpmn:subProcess>
    <bpmn:manualTask id="SC_MeetBCS" name="Tổ chức họp ban cán sự lớp">
      <bpmn:documentation>Trong TO-BE, cuộc họp BCS đặt sau khi các Agent xử lý xong để BCS rà soát kết quả tự động trước khi họp lớp. Nếu AS-IS đặt cuộc họp này ở thời điểm khác thì cần đối chiếu và chỉnh thứ tự.</bpmn:documentation>
      <bpmn:incoming>FSC31</bpmn:incoming>
      <bpmn:outgoing>FSC32</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="SC_ReviewDraft" name="BCS rà soát / thống nhất điểm trên hệ thống">
      <bpmn:incoming>FSC32</bpmn:incoming>
      <bpmn:outgoing>FSC33</bpmn:outgoing>
      <bpmn:humanPerformer id="HP_SC_ReviewDraft"><bpmn:resourceRef>Res_BCS</bpmn:resourceRef></bpmn:humanPerformer>
    </bpmn:userTask>
    <bpmn:manualTask id="SC_ClassMeeting" name="Tổ chức họp lớp">
      <bpmn:incoming>FSC33</bpmn:incoming>
      <bpmn:outgoing>FSC34</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="SC_PublishDraft" name="BCS công bố bảng điểm dự kiến trên hệ thống">
      <bpmn:incoming>FSC34</bpmn:incoming>
      <bpmn:outgoing>FSC35</bpmn:outgoing>
      <bpmn:humanPerformer id="HP_SC_PublishDraft"><bpmn:resourceRef>Res_BCS</bpmn:resourceRef></bpmn:humanPerformer>
    </bpmn:userTask>
    <bpmn:subProcess id="SC_RespPerStudent" name="Phản hồi điểm và giải quyết khiếu nại từng sinh viên (multi-instance)">
      <bpmn:documentation>Multi-instance song song cho từng sinh viên có điểm dự kiến: gửi điểm, chờ đồng ý / khiếu nại / hết hạn, xử lý khiếu nại. Mỗi sinh viên có một gateway chờ riêng nên phản hồi của người này không làm kết thúc việc chờ của người khác. Chỉ khi mọi instance hoàn tất mới chốt điểm và gửi GVCN.</bpmn:documentation>
      <bpmn:incoming>FSC35</bpmn:incoming>
      <bpmn:outgoing>FSC49</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_RespPerStudent">
        <bpmn:dataInput id="DIn_ScoredList" name="Danh sách sinh viên đã có điểm dự kiến" isCollection="true"/>
        <bpmn:inputSet id="InSet_RespPerStudent"><bpmn:dataInputRefs>DIn_ScoredList</bpmn:dataInputRefs></bpmn:inputSet>
        <bpmn:outputSet id="OutSet_RespPerStudent"/>
      </bpmn:ioSpecification>
      <bpmn:multiInstanceLoopCharacteristics id="MI_RespPerStudent" isSequential="false">
        <bpmn:loopDataInputRef>DIn_ScoredList</bpmn:loopDataInputRef>
        <bpmn:inputDataItem id="Item_ScoredStudent" name="Sinh viên"/>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="P2_Start" name="Bắt đầu theo từng SV">
        <bpmn:outgoing>FP2_01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sendTask id="SC_NotifyDraft" name="Gửi điểm dự kiến cho sinh viên" messageRef="Msg_Draft">
        <bpmn:incoming>FP2_01</bpmn:incoming>
        <bpmn:outgoing>FSC36</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="SC_WaitAppeal" name="Chờ đồng ý / khiếu nại / hết hạn">
        <bpmn:incoming>FSC36</bpmn:incoming>
        <bpmn:outgoing>FSC37</bpmn:outgoing>
        <bpmn:outgoing>FSC38</bpmn:outgoing>
        <bpmn:outgoing>FSC39</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="SC_GetAccept" name="Nhận xác nhận đồng ý">
        <bpmn:documentation>Khi nhận: đặt responded = true (để SC_RemindEventSub không nhắc nhầm).</bpmn:documentation>
        <bpmn:incoming>FSC37</bpmn:incoming>
        <bpmn:outgoing>FSC37b</bpmn:outgoing>
        <bpmn:messageEventDefinition id="EventDef_SC_GetAccept" messageRef="Msg_Accept"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="P2_EndAccept" name="SV đồng ý điểm">
        <bpmn:incoming>FSC37b</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="SC_GetAppeal" name="Nhận khiếu nại điểm">
        <bpmn:documentation>Khi nhận: đặt responded = true (để SC_RemindEventSub không nhắc sinh viên đã nộp khiếu nại trong lúc BCS đang xử lý).</bpmn:documentation>
        <bpmn:incoming>FSC38</bpmn:incoming>
        <bpmn:outgoing>FSC42</bpmn:outgoing>
        <bpmn:messageEventDefinition id="EventDef_SC_GetAppeal" messageRef="Msg_Appeal"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="SC_AppealTimeout" name="Hết hạn khiếu nại">
        <bpmn:documentation>Hạn đồng ý / khiếu nại điểm dự kiến (appealPeriod). Thời hạn là tham số cấu hình (Tobe.docx chưa quy định số ngày cụ thể); nhà trường/BCS khai báo khi triển khai.</bpmn:documentation>
        <bpmn:incoming>FSC39</bpmn:incoming>
        <bpmn:outgoing>FSC39b</bpmn:outgoing>
        <bpmn:timerEventDefinition id="EventDef_SC_AppealTimeout"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${appealPeriod}</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="SC_AutoAccept" name="Ghi nhận tự động chấp nhận điểm và thông báo cho SV" messageRef="Msg_AutoAccepted">
        <bpmn:documentation>v5: đổi từ serviceTask sang sendTask. Nhà trường giữ đồng hồ chuẩn nên phải báo cho sinh viên (MF15) để đóng phiên phía sinh viên, tránh trường hợp sinh viên đang soạn giải trình rồi bị treo ở ST_GetResolution.</bpmn:documentation>
        <bpmn:incoming>FSC39b</bpmn:incoming>
        <bpmn:outgoing>FSC39c</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="P2_EndAuto" name="Điểm được chấp nhận tự động">
        <bpmn:incoming>FSC39c</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="SC_HandleAppeal" name="BCS xem xét và giải trình khiếu nại">
        <bpmn:incoming>FSC42</bpmn:incoming>
        <bpmn:outgoing>FSC43</bpmn:outgoing>
        <bpmn:humanPerformer id="HP_SC_HandleAppeal"><bpmn:resourceRef>Res_BCS</bpmn:resourceRef></bpmn:humanPerformer>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SC_GAdjust" default="FSC45" name="Cần điều chỉnh?">
        <bpmn:incoming>FSC43</bpmn:incoming>
        <bpmn:outgoing>FSC44</bpmn:outgoing>
        <bpmn:outgoing>FSC45</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="SC_Edit" name="BCS điều chỉnh điểm và ghi rõ lý do">
        <bpmn:incoming>FSC44</bpmn:incoming>
        <bpmn:outgoing>FSC46</bpmn:outgoing>
        <bpmn:humanPerformer id="HP_SC_Edit"><bpmn:resourceRef>Res_BCS</bpmn:resourceRef></bpmn:humanPerformer>
      </bpmn:userTask>
      <bpmn:serviceTask id="SC_UpdateScore" name="Hệ thống cập nhật lại điểm">
        <bpmn:incoming>FSC46</bpmn:incoming>
        <bpmn:outgoing>FSC47</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SC_ReplyAppeal" name="Thông báo kết quả giải trình cho sinh viên" messageRef="Msg_Resolution">
        <bpmn:incoming>FSC45</bpmn:incoming>
        <bpmn:incoming>FSC47</bpmn:incoming>
        <bpmn:outgoing>FSC48</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="P2_EndReply" name="Đã giải quyết khiếu nại">
        <bpmn:incoming>FSC48</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:subProcess id="SC_RemindEventSub" name="Event sub-process: nhắc nhở hạn phản hồi" triggeredByEvent="true">
        <bpmn:documentation>Nhắc nhở không ngắt luồng chính: khi gần hết hạn phản hồi thì gửi nhắc nhở cho đúng sinh viên đó. v6: có cổng kiểm tra responded (đặt true khi nhận SC_GetAccept hoặc SC_GetAppeal) để không nhắc sinh viên đã đồng ý/khiếu nại nhưng đang chờ BCS xử lý, lúc này instance SC_RespPerStudent vẫn còn hoạt động nên timer vẫn nổ.</bpmn:documentation>
        <bpmn:startEvent id="SC_Remind_Start" name="Gần hết hạn phản hồi" isInterrupting="false">
          <bpmn:documentation>Timer start không ngắt trong event sub-process, tính từ lúc gửi điểm cho từng sinh viên (reminderAfter). Thời hạn là tham số cấu hình (Tobe.docx chưa quy định số ngày cụ thể); nhà trường/BCS khai báo khi triển khai.</bpmn:documentation>
          <bpmn:outgoing>FES_S1</bpmn:outgoing>
          <bpmn:timerEventDefinition id="EventDef_SC_Remind_Start"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${reminderAfter}</bpmn:timeDuration></bpmn:timerEventDefinition>
        </bpmn:startEvent>
        <bpmn:exclusiveGateway id="SC_GResponded" name="Đã phản hồi chưa?" default="FES_S4">
          <bpmn:incoming>FES_S1</bpmn:incoming>
          <bpmn:outgoing>FES_S3</bpmn:outgoing>
          <bpmn:outgoing>FES_S4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sendTask id="SC_SendReminder" name="Gửi nhắc nhở hạn phản hồi cho sinh viên" messageRef="Msg_Reminder">
          <bpmn:incoming>FES_S3</bpmn:incoming>
          <bpmn:outgoing>FES_S2</bpmn:outgoing>
        </bpmn:sendTask>
        <bpmn:endEvent id="SC_Remind_End" name="Đã gửi nhắc nhở">
          <bpmn:incoming>FES_S2</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:endEvent id="SC_Remind_Skip" name="Đã phản hồi – bỏ qua nhắc">
          <bpmn:incoming>FES_S4</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="FES_S1" sourceRef="SC_Remind_Start" targetRef="SC_GResponded"/>
        <bpmn:sequenceFlow id="FES_S3" name="Chưa" sourceRef="SC_GResponded" targetRef="SC_SendReminder"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!responded}</bpmn:conditionExpression></bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="FES_S4" name="Đã" sourceRef="SC_GResponded" targetRef="SC_Remind_Skip"/>
        <bpmn:sequenceFlow id="FES_S2" sourceRef="SC_SendReminder" targetRef="SC_Remind_End"/>
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="FP2_01" sourceRef="P2_Start" targetRef="SC_NotifyDraft"/>
      <bpmn:sequenceFlow id="FSC36" sourceRef="SC_NotifyDraft" targetRef="SC_WaitAppeal"/>
      <bpmn:sequenceFlow id="FSC37" sourceRef="SC_WaitAppeal" targetRef="SC_GetAccept"/>
      <bpmn:sequenceFlow id="FSC37b" sourceRef="SC_GetAccept" targetRef="P2_EndAccept"/>
      <bpmn:sequenceFlow id="FSC38" sourceRef="SC_WaitAppeal" targetRef="SC_GetAppeal"/>
      <bpmn:sequenceFlow id="FSC39" sourceRef="SC_WaitAppeal" targetRef="SC_AppealTimeout"/>
      <bpmn:sequenceFlow id="FSC39b" sourceRef="SC_AppealTimeout" targetRef="SC_AutoAccept"/>
      <bpmn:sequenceFlow id="FSC39c" sourceRef="SC_AutoAccept" targetRef="P2_EndAuto"/>
      <bpmn:sequenceFlow id="FSC42" sourceRef="SC_GetAppeal" targetRef="SC_HandleAppeal"/>
      <bpmn:sequenceFlow id="FSC43" sourceRef="SC_HandleAppeal" targetRef="SC_GAdjust"/>
      <bpmn:sequenceFlow id="FSC44" name="Điều chỉnh" sourceRef="SC_GAdjust" targetRef="SC_Edit"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${needAdjust}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="FSC45" name="Không điều chỉnh" sourceRef="SC_GAdjust" targetRef="SC_ReplyAppeal"/>
      <bpmn:sequenceFlow id="FSC46" sourceRef="SC_Edit" targetRef="SC_UpdateScore"/>
      <bpmn:sequenceFlow id="FSC47" sourceRef="SC_UpdateScore" targetRef="SC_ReplyAppeal"/>
      <bpmn:sequenceFlow id="FSC48" sourceRef="SC_ReplyAppeal" targetRef="P2_EndReply"/>
    </bpmn:subProcess>
    <bpmn:userTask id="SC_Finalize" name="BCS chốt điểm trên hệ thống">
      <bpmn:incoming>FSC49</bpmn:incoming>
      <bpmn:outgoing>FSC50</bpmn:outgoing>
      <bpmn:humanPerformer id="HP_SC_Finalize"><bpmn:resourceRef>Res_BCS</bpmn:resourceRef></bpmn:humanPerformer>
    </bpmn:userTask>
    <bpmn:userTask id="SC_SendFinal" name="BCS gửi bảng điểm đã chốt cho giáo viên chủ nhiệm">
      <bpmn:incoming>FSC50</bpmn:incoming>
      <bpmn:outgoing>FSC51</bpmn:outgoing>
      <bpmn:humanPerformer id="HP_SC_SendFinal"><bpmn:resourceRef>Res_BCS</bpmn:resourceRef></bpmn:humanPerformer>
    </bpmn:userTask>
    <bpmn:endEvent id="SC_End" name="Hoàn tất chuyển bảng điểm">
      <bpmn:incoming>FSC51</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="FSC01" sourceRef="SC_Start" targetRef="SC_Notify"/>
    <bpmn:sequenceFlow id="FSC02" sourceRef="SC_Notify" targetRef="SC_PerStudent"/>
    <bpmn:sequenceFlow id="FSC31" sourceRef="SC_PerStudent" targetRef="SC_MeetBCS"/>
    <bpmn:sequenceFlow id="FSC32" sourceRef="SC_MeetBCS" targetRef="SC_ReviewDraft"/>
    <bpmn:sequenceFlow id="FSC33" sourceRef="SC_ReviewDraft" targetRef="SC_ClassMeeting"/>
    <bpmn:sequenceFlow id="FSC34" sourceRef="SC_ClassMeeting" targetRef="SC_PublishDraft"/>
    <bpmn:sequenceFlow id="FSC35" sourceRef="SC_PublishDraft" targetRef="SC_RespPerStudent"/>
    <bpmn:sequenceFlow id="FSC49" sourceRef="SC_RespPerStudent" targetRef="SC_Finalize"/>
    <bpmn:sequenceFlow id="FSC50" sourceRef="SC_Finalize" targetRef="SC_SendFinal"/>
    <bpmn:sequenceFlow id="FSC51" sourceRef="SC_SendFinal" targetRef="SC_End"/>
    <bpmn:textAnnotation id="Note_BCS"><bpmn:text>Ghi chú: task màu cam do Ban cán sự lớp thực hiện. BPMN 2.0 không cho vẽ lane bên trong sub-process, nên vai trò BCS được thể hiện bằng màu, tiền tố "BCS" và thuộc tính humanPerformer (Res_BCS).</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Nhom8_Advanced">
    <bpmndi:BPMNPlane id="Plane_Nhom8_Advanced" bpmnElement="Collaboration_ToBe_Advanced">
      <bpmndi:BPMNShape id="Shape_Pool_Student" bpmnElement="Pool_Student" isHorizontal="true" bioc:stroke="#536279" bioc:fill="#FFFFFF">
        <dc:Bounds x="100" y="60" width="8000" height="480"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Pool_School" bpmnElement="Pool_School" isHorizontal="true" bioc:stroke="#536279" bioc:fill="#FFFFFF">
        <dc:Bounds x="100" y="580" width="8000" height="1250"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Pool_GVCN" bpmnElement="Pool_GVCN" isHorizontal="true" bioc:stroke="#536279" bioc:fill="#FFFFFF">
        <dc:Bounds x="100" y="1870" width="8000" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_System" bpmnElement="Lane_System" isHorizontal="true" bioc:stroke="#8293A7" bioc:fill="#F4F8FC">
        <dc:Bounds x="130" y="580" width="7970" height="1040"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_BCS" bpmnElement="Lane_BCS" isHorizontal="true" bioc:stroke="#8293A7" bioc:fill="#FBF8F0">
        <dc:Bounds x="130" y="1620" width="7970" height="210"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ES_Info" bpmnElement="ES_Info" isExpanded="true" bioc:stroke="#B98B2F" bioc:fill="#FFFDF5">
        <dc:Bounds x="1410" y="340" width="620" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ES_Proof" bpmnElement="ES_Proof" isExpanded="true" bioc:stroke="#B98B2F" bioc:fill="#FFFDF5">
        <dc:Bounds x="2970" y="340" width="700" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ES_Remind" bpmnElement="ES_Remind" isExpanded="true" bioc:stroke="#B98B2F" bioc:fill="#FFFDF5">
        <dc:Bounds x="5510" y="340" width="300" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ES_Closed" bpmnElement="ES_Closed" isExpanded="true" bioc:stroke="#B98B2F" bioc:fill="#FFFDF5">
        <dc:Bounds x="1010" y="340" width="380" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ES_AutoAccept" bpmnElement="ES_AutoAccept" isExpanded="true" bioc:stroke="#B98B2F" bioc:fill="#FFFDF5">
        <dc:Bounds x="5920" y="340" width="330" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ES_Closed_Start" bpmnElement="ES_Closed_Start" bioc:stroke="#288A4B" bioc:fill="#EAF9ED">
        <dc:Bounds x="1030" y="402" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1012" y="364" width="100" height="34"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ES_Closed_End" bpmnElement="ES_Closed_End" bioc:stroke="#A33F46" bioc:fill="#FFF0EF">
        <dc:Bounds x="1280" y="402" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1243" y="442" width="110" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ES_AutoAccept_Start" bpmnElement="ES_AutoAccept_Start" bioc:stroke="#288A4B" bioc:fill="#EAF9ED">
        <dc:Bounds x="5982" y="402" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="5928" y="364" width="140" height="34"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ES_AutoAccept_End" bpmnElement="ES_AutoAccept_End" bioc:stroke="#A33F46" bioc:fill="#FFF0EF">
        <dc:Bounds x="6150" y="402" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="6103" y="442" width="130" height="44"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SC_PerStudent" bpmnElement="SC_PerStudent" isExpanded="true" bioc:stroke="#3B5998" bioc:fill="#FAFCFF">
        <dc:Bounds x="760" y="600" width="3450" height="980"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SC_AlertEventSub" bpmnElement="SC_AlertEventSub" isExpanded="true" bioc:stroke="#B98B2F" bioc:fill="#FFFDF5">
        <dc:Bounds x="2420" y="670" width="480" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SC_AIReview" bpmnElement="SC_AIReview" isExpanded="true" bioc:stroke="#3B5998" bioc:fill="#FAFCFF">
        <dc:Bounds x="1610" y="930" width="700" height="270"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SC_RespPerStudent" bpmnElement="SC_RespPerStudent" isExpanded="true" bioc:stroke="#3B5998" bioc:fill="#FAFCFF">
        <dc:Bounds x="5240" y="1060" width="2130" height="530"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SC_RemindEventSub" bpmnElement="SC_RemindEventSub" isExpanded="true" bioc:stroke="#B98B2F" bioc:fill="#FFFDF5">
        <dc:Bounds x="5340" y="1400" width="450" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ST_Start" bpmnElement="ST_Start" bioc:stroke="#288A4B" bioc:fill="#EAF9ED">
        <dc:Bounds x="362" y="122" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="325" y="88" width="110" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
